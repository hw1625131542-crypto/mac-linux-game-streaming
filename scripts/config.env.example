# ============================================================================
#  配置文件 —— 所有脚本都从这里读值
#
#  用法：
#      cp config.env.example config.env
#      $EDITOR config.env          # 改下面标了 ★ 的几项
#
#  ★ 标记的项必须改成你自己的；其余保持默认通常就行。
#  这个文件不会被提交到 git（见 .gitignore）。
# ============================================================================

# ============================================================================
#  一、服务器（跑游戏的那台 Linux 机器）
# ============================================================================

# ★ 服务器地址。填局域网 IP 最稳（例如家里的 192.168.1.50）；
#   如果你的两台机器在同一个 Wi-Fi/交换机下，就用局域网 IP，
#   不要用公网地址或内网穿透 —— 串流对延迟和抖动很敏感。
SERVER_HOST="192.168.1.50"

# ★ 你在服务器上的 Linux 用户名
SERVER_USER="player"

# SSH 端口（默认 22；如果你改过 sshd 的 Port，这里也要改）
SERVER_SSH_PORT="22"

# 备用地址（可选）。比如同时装了 Tailscale：
#   SSH_HOSTS=("192.168.1.50" "100.64.0.1")
# 留空则只用 SERVER_HOST。
# 启动脚本会按顺序尝试，第一个能连上的就用。
SERVER_HOST_FALLBACK=""

# ============================================================================
#  二、串流主机名（Mac 端看到的那个名字）
# ============================================================================

# ★ Sunshine 对外广播的名字，随便起（例如 GAME-PC、MY-RIG）。
#   注意：这个名字要同时出现在三个地方，必须完全一致，否则 Moonlight 会报
#   "Found unexpected PC ... looking for ..."：
#     1) 这里
#     2) Sunshine 配置里的 sunshine_name
#     3) Mac 端 Moonlight 里配对过的主机名
STREAM_HOST_NAME="GAME-PC"

# Sunshine 的 Web 管理界面端口（配密要用，默认 47990）
SUNSHINE_WEB_PORT="47990"

# ============================================================================
#  三、虚拟显示器（无头 Xorg）
# ============================================================================

# ★ 串流分辨率。**建议填你 Mac 屏幕的原生分辨率**，这样缩放最少、最清晰。
#   MacBook Air 13" 是 2560x1664；MacBook Pro 14" 是 3024x1964；
#   外接 2K 显示器通常是 2560x1440。
#   怎么查：Mac 上「系统设置 → 显示器」，或运行 `system_profiler SPDisplaysDataType`
STREAM_WIDTH="2560"
STREAM_HEIGHT="1600"

# 刷新率。无头虚拟屏用 60 就够了
STREAM_REFRESH="60"

# ★ DPI。96 是标准值。**这个值非常关键**：它由 EDID 里的物理尺寸反推，
#   如果不对（比如算成 191），游戏启动器一类的程序会被放大 2 倍、按钮全部错位。
STREAM_DPI="96"

# X display 编号。:200 是个不常用的号，避免和真实桌面（:0）或其它 Xvfb 撞车
DISPLAY_NUM=":200"

# EDID 文件存放路径（make-edid.py 生成、Xorg 读取）
EDID_PATH="$HOME/game-stream-edid.bin"

# Xorg 配置文件路径（由 20-setup-headless-xorg.sh 生成）
XORG_CONF_PATH="$HOME/xorg-headless.conf"

# ★ 显卡的「输出连接器」名字。无头机器没有真显示器，需要指定一个名字让驱动"以为"接了显示器。
#
#   怎么查你显卡上有什么连接器：
#       ls /sys/class/drm/                   # 例如 card1-HDMI-A-1、card1-DP-1 ...
#
#   NVIDIA 驱动内部常用的名字（按接口类型挑一个试）：
#       DFP-0 / DFP-1 ...    数字接口（HDMI/DP 通常都归到这里，最常用）
#       HDMI-0, DP-0, DP-1 ...
#   笔记本的独显一般没有直连输出，用 DFP-0 通常就能骗过去。
#   如果 X 起不来，换一个名字重跑 20-setup-headless-xorg.sh 即可。
XORG_OUTPUT="DFP-0"

# ============================================================================
#  四、Moonlight 串流参数
# ============================================================================

# ★ 码率（Kbps）。
#   100Mbps 网口 → 35000~45000；千兆有线 → 50000~80000；Wi-Fi 建议 20000~35000。
#   给小了画面糊，给大了丢包卡顿；配合服务端的 fec_percentage 一起调。
BITRATE_KBPS="35000"

# 串流帧率。要和 STREAM_REFRESH 一致
STREAM_FPS="60"

# 服务端前向纠错百分比（0-255）。
#   有线：20~30；Wi-Fi 有丢包：40~60。注意它会按比例增加实际带宽占用。
FEC_PERCENT="40"

# ============================================================================
#  五、要串流的游戏（会话启动脚本会用到）
# ============================================================================

# 游戏工作目录（启动器会在这里找配置和存档）
GAME_DIR="$HOME/.minecraft"

# 启动器可执行文件路径
GAME_LAUNCHER="/usr/bin/minecraft-launcher"

# 用 pgrep -f 判断「游戏是否已经在跑」的模式
#   Minecraft: net.minecraft.client.main.Main
#   Steam:    不用改（Steam 用另一个判断方式，见 50-session-up.sh）
#   ★ 用其它游戏就改成那个游戏的进程特征串
GAME_PROC_PATTERN="net.minecraft.client.main.Main"

# 启动器的窗口类名（xdotool 用来找窗口）。
#   Minecraft 官方启动器是 minecraft-launcher
GAME_WINDOW_CLASS="minecraft-launcher"

# 游戏窗口的类名（用于「游戏是否已开窗」的判断）
GAME_WINDOW_CLASS_2="Minecraft"

# ★ 自动点击「开始游戏」按钮的坐标（可选功能，填 "0 0" 关闭）。
#   很多游戏（如 Minecraft）的正版身份只能由官方启动器发起，
#   但那个按钮的点击可以让脚本代劳。
#   怎么得到坐标：在 2560x1664 下把启动器铺满屏幕，用截图量一下按钮中心的像素位置。
#   填 0 0 表示不自动点击。
AUTO_CLICK_X="1280"
AUTO_CLICK_Y="1145"

# ============================================================================
#  六、Mac 端（本地设置，服务端脚本不读）
# ============================================================================

# Mac 上 Moonlight 的路径
MOONLIGHT_APP="/Applications/Moonlight.app"

# 日志目录
LOG_DIR="/tmp"
