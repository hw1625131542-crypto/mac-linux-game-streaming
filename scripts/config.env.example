# ============================================================================
#  Configuration — every script reads its values from this file
#  配置文件 —— 所有脚本都从这里读值
#
#  Usage / 用法:
#      cp config.env.example config.env
#      $EDITOR config.env            # change the items marked ★ / 改标了 ★ 的项
#
#  ★ = you must set this / 必须改成你自己的
#  Everything else works with the defaults on a typical setup.
#  其余保持默认通常就行。
#
#  This file is gitignored — your real IPs and usernames never get committed.
#  这个文件已被 gitignore 排除，你填的真实 IP / 用户名不会被提交。
# ============================================================================


# ============================================================================
#  1. HOST — the Linux machine that runs the game
#     一、服务器 —— 跑游戏的那台 Linux 机器
# ============================================================================

# ★ Host address. Use the LAN IP (e.g. 192.168.1.50) — streaming is very
#   sensitive to latency and jitter, so avoid WAN addresses and tunnels here.
# ★ 服务器地址。填局域网 IP 最稳（例如家里的 192.168.1.50）；
#   串流对延迟和抖动很敏感，不要用公网地址或内网穿透。
SERVER_HOST="192.168.1.50"

# ★ Your Linux username on that machine.
# ★ 你在服务器上的 Linux 用户名。
SERVER_USER="player"

# SSH port (default 22; change it if you changed `Port` in sshd_config).
# SSH 端口（默认 22；如果你改过 sshd 的 Port，这里也要改）。
SERVER_SSH_PORT="22"

# Optional fallback address, tried when SERVER_HOST is unreachable.
# Useful when you have both a LAN IP and a Tailscale IP.
# 备用地址（可选）：主地址连不上时会自动尝试它。
# 同时有局域网 IP 和 Tailscale IP 时很有用。
#   Example / 例子: SERVER_HOST_FALLBACK="100.64.0.1"
SERVER_HOST_FALLBACK=""


# ============================================================================
#  2. STREAM NAME — what the Mac sees in Moonlight
#     二、串流主机名 —— Mac 端在 Moonlight 里看到的名字
# ============================================================================

# ★ The name Sunshine advertises. Pick anything (e.g. GAME-PC).
#   IMPORTANT: this exact string must match in three places, otherwise
#   Moonlight reports `Found unexpected PC "X" looking for "Y"`:
#     1) here  2) sunshine_name in Sunshine's config  3) the paired host in Moonlight
# ★ Sunshine 对外广播的名字，随便起（例如 GAME-PC）。
#   注意：这个名字必须三处完全一致，否则 Moonlight 会报
#   "Found unexpected PC ... looking for ..."：
#     1) 这里  2) Sunshine 配置里的 sunshine_name  3) Moonlight 里配对过的主机名
STREAM_HOST_NAME="GAME-PC"

# Sunshine's web UI port (needed for the first-time setup).
# Sunshine 的 Web 管理界面端口（首次配用户名密码时要用）。
SUNSHINE_WEB_PORT="47990"


# ============================================================================
#  3. VIRTUAL DISPLAY — the headless Xorg screen
#     三、虚拟显示器 —— headless Xorg 的分辨率
# ============================================================================

# ★ Streaming resolution. Set this to your Mac screen's NATIVE resolution —
#   then the client needs no scaling and the image stays crisp.
#     MacBook Air 13"    2560x1664
#     MacBook Pro 14"    3024x1964
#     MacBook Pro 16"    3456x2234
#     external 1440p     2560x1440
#   Check yours: System Settings → Displays, or `system_profiler SPDisplaysDataType`
# ★ 串流分辨率。**建议填你 Mac 屏幕的原生分辨率**，这样缩放最少、最清晰。
#   怎么查：Mac 上「系统设置 → 显示器」，或运行 system_profiler SPDisplaysDataType
STREAM_WIDTH="2560"
STREAM_HEIGHT="1600"

# Refresh rate. 60 is all you need for a virtual display.
# 刷新率。虚拟屏用 60 就够了。
STREAM_REFRESH="60"

# ★ DPI. 96 is the standard value.
#   This one matters a lot: it is derived from the EDID's physical size, and if
#   it comes out wrong (e.g. 191) then CEF-based apps — which game launchers
#   almost always are — scale their UI 2x and the buttons go off-screen.
# ★ DPI。96 是标准值。**这个值非常关键**：它由 EDID 里的物理尺寸反推，
#   如果不对（比如算成 191），CEF 类程序（游戏启动器基本都是）会把 UI
#   放大两倍、按钮全部错位，你连「开始游戏」都点不到。
STREAM_DPI="96"

# X display number. :200 is deliberately unusual so it won't collide with a
# real desktop (:0) or other Xvfb instances.
# X display 编号。:200 是个不常用的号，避免和真实桌面（:0）或其它 Xvfb 撞车。
DISPLAY_NUM=":200"

# Where the EDID file lives (generated by make-edid.py, read by Xorg).
# EDID 文件路径（make-edid.py 生成、Xorg 读取）。
EDID_PATH="$HOME/game-stream-edid.bin"

# Where the generated Xorg config lives.
# Xorg 配置文件路径（由 20-setup-headless-xorg.sh 生成）。
XORG_CONF_PATH="$HOME/xorg-headless.conf"

# ★ The GPU's output connector name. A headless machine has no real monitor,
#   so we must name one to make the driver believe a display is attached.
#
#   Find out what your GPU exposes:
#       ls /sys/class/drm/                   # e.g. card1-HDMI-A-1, card1-DP-1
#
#   Names the NVIDIA driver understands (pick by interface type):
#       DFP-0 / DFP-1 ...    digital outputs (HDMI/DP usually land here — most common)
#       HDMI-0, DP-0, DP-1 ...
#   Laptop dGPUs usually have no directly wired output; DFP-0 normally works.
#   If X fails to start, try another name and re-run 20-setup-headless-xorg.sh.
# ★ 显卡的「输出连接器」名字。无头机器没有真显示器，需要指定一个名字让驱动
#   "以为"接了显示器。查法：ls /sys/class/drm/
#   NVIDIA 驱动常用名字：DFP-0 / DFP-1（数字接口，最常用）、HDMI-0、DP-0 …
#   笔记本独显一般没有直连输出，用 DFP-0 通常就能骗过去。
#   起不来的话换一个名字重跑 20-setup-headless-xorg.sh。
XORG_OUTPUT="DFP-0"


# ============================================================================
#  4. STREAMING QUALITY — Moonlight / Sunshine tuning
#     四、串流画质参数
# ============================================================================

# ★ Bitrate in Kbps.
#     gigabit wired    50000~80000
#     100Mbps wired    35000~45000
#     Wi-Fi (5GHz)     25000~40000
#   Too low looks blurry; too high causes packet loss and stutter.
#   Tune it together with FEC_PERCENT below.
# ★ 码率（Kbps）。千兆有线 50000~80000；百兆有线 35000~45000；
#   Wi-Fi 建议 25000~40000。给小了画面糊，给大了丢包卡顿。
#   要配合下面的 FEC_PERCENT 一起调。
BITRATE_KBPS="35000"

# Stream framerate — keep it equal to STREAM_REFRESH.
# 串流帧率，和 STREAM_REFRESH 保持一致。
STREAM_FPS="60"

# Forward error correction, in percent (0-255).
#   wired: 20~30      Wi-Fi with packet loss: 40~60
# Note it increases actual bandwidth proportionally: 40% FEC on a 35 Mbps
# stream occupies roughly 49 Mbps on the wire.
# 服务端前向纠错百分比（0-255）。有线 20~30；Wi-Fi 有丢包 40~60。
# 注意它会按比例增加实际带宽占用：35 Mbps 的视频 + 40% FEC ≈ 实际 49 Mbps。
FEC_PERCENT="40"

# Video encoder: nvenc (NVIDIA) / amdvce (AMD) / quicksync (Intel).
# 视频编码器：nvenc（NVIDIA）/ amdvce（AMD）/ quicksync（Intel）。
SUNSHINE_ENCODER="nvenc"


# ============================================================================
#  5. THE GAME — used by the session startup script
#     五、要串流的游戏 —— 会话启动脚本会用到
# ============================================================================

# Working directory the launcher expects (where saves and configs live).
# 游戏工作目录（启动器在这里找配置和存档）。
GAME_DIR="$HOME/.minecraft"

# Launcher executable.
# 启动器可执行文件路径。
GAME_LAUNCHER="/usr/bin/minecraft-launcher"

# A `pgrep -f` pattern used to detect "the game is already running", so we never
# launch a second instance. Change it for other games.
#   Minecraft:  net.minecraft.client.main.Main
# 用 pgrep -f 判断「游戏是否已经在跑」的模式（避免开出第二个实例）。
#   Minecraft 用 net.minecraft.client.main.Main；换别的游戏就改成那个进程的特征串。
GAME_PROC_PATTERN="net.minecraft.client.main.Main"

# The launcher window's class name (xdotool uses it to find the window).
# 启动器窗口的类名（xdotool 用来找窗口）。
GAME_WINDOW_CLASS="minecraft-launcher"

# The game window's class name (used to detect that the game window appeared,
# and to strip its title bar via an openbox rule).
# 游戏窗口的类名（用于判断游戏是否开窗，以及给它加无边框规则）。
GAME_WINDOW_CLASS_2="Minecraft"

# ★ Optional: auto-click a button in the launcher, e.g. Minecraft's green
#   "Play". Premium authentication can only be initiated by the official
#   launcher itself, but that single click can be automated.
#   How to get the coordinates: run the launcher full-screen at
#   STREAM_WIDTH x STREAM_HEIGHT, take a screenshot, and read off the button's
#   centre pixel position.
#   Set both to 0 to disable.
# ★ 可选：自动点击启动器上的按钮（比如 Minecraft 的绿色「开始游戏」）。
#   正版身份只能由官方启动器自己发起，但"点按钮"这一步可以代劳。
#   怎么得到坐标：把启动器铺满 STREAM_WIDTH x STREAM_HEIGHT，截图量一下按钮
#   中心的像素位置。填 0 0 表示不自动点击。
AUTO_CLICK_X="1280"
AUTO_CLICK_Y="1145"


# ============================================================================
#  6. MAC SIDE — only read by the Mac scripts
#     六、Mac 端设置 —— 只有 Mac 上的脚本会读
# ============================================================================

# Path to Moonlight on the Mac.
# Mac 上 Moonlight 的路径。
MOONLIGHT_APP="/Applications/Moonlight.app"

# Where temporary logs go.
# 临时日志目录。
LOG_DIR="/tmp"

# ============================================================================
#  7. HYBRID GPU / MODE SWITCHING — only relevant if the machine also runs a
#     desktop (see docs/hybrid-gpu.md)
#     七、混合显卡 / 模式切换 —— 只有在同一台机器上还要跑桌面时才需要
# ============================================================================

# systemd unit name of the headless Xorg.
# 无头 Xorg 的 systemd 服务名。
XORG_UNIT="mc-xorg"

# systemd user unit name of Sunshine (distro packaging may differ — check
# `systemctl --user list-unit-files | grep -i sunshine`).
# Sunshine 的用户级服务名（发行版打包可能不同，用上面那条命令确认）。
SUNSHINE_UNIT="app-dev.lizardbyte.app.Sunshine"

# ★ Set to 1 to automatically return to the desktop when the streaming client
#   disconnects (closes the game first, so the GPU is released).
#   0 = stay in streaming mode until you switch back manually.
# ★ 设为 1 表示串流断开后自动回到桌面（会先关闭游戏以释放显卡）。
#   0 = 保持串流模式，等你手动切回。
AUTO_RETURN="0"

# Grace period in seconds before the auto-return acts (protects against a brief
# network hiccup killing your session).
# 自动收尾前的宽限秒数（防止网络抖一下就误杀会话）。
AUTO_RETURN_GRACE="30"
